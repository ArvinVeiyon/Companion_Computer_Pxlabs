+// With SW D2C the align step is skipped whenever a frameset arrives without a usable
+// colour frame, and the depth frame then stays at its native resolution. Callers use
+// this to drop such a frame instead of publishing it on the registered topics, where
+// consumers are entitled to assume depth is no larger than colour -- RTAB-Map asserts
+// exactly that in Memory.cpp::createSignature() and aborts the process when it fails.
+bool OBCameraNode::isDepthAlignedToTarget(const std::shared_ptr<ob::FrameSet> &frame_set) const {
+  if (!depth_registration_ || !align_filter_ || !frame_set) {
+    return true;
+  }
+  auto depth_frame = frame_set->getFrame(OB_FRAME_DEPTH);
+  if (!depth_frame || !depth_frame->is<ob::VideoFrame>()) {
+    return true;
+  }
+  auto target_frame = frame_set->getFrame(STREAM_TYPE_TO_FRAME_TYPE.at(align_target_stream_));
+  if (!target_frame || !target_frame->is<ob::VideoFrame>()) {
+    return false;
+  }
+  auto depth_video = depth_frame->as<ob::VideoFrame>();
+  auto target_video = target_frame->as<ob::VideoFrame>();
+  return depth_video->getWidth() == target_video->getWidth() &&
+         depth_video->getHeight() == target_video->getHeight();
+}
