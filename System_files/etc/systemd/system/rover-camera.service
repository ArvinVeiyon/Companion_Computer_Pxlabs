[Unit]
Description=Orbbec Gemini 336L ROS2 wrapper (depth+color+IMU)
After=network.target 
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=roz
Group=roz
Environment=HOME=/home/roz
WorkingDirectory=/home/roz/ros2_ws
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash && source /home/roz/ros2_ws/install/setup.bash && exec ros2 launch orbbec_camera gemini_330_series.launch.py enable_accel:=true enable_gyro:=true enable_point_cloud:=true'
Restart=always
RestartSec=5
KillMode=control-group
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
