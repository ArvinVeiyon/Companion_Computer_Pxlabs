[Unit]
Description=Depth image to /scan + base_link->camera_link TF
After=network.target rover-camera.service
Wants=rover-camera.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=roz
Group=roz
Environment=HOME=/home/roz
WorkingDirectory=/home/roz/ros2_ws
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash && source /home/roz/ros2_ws/install/setup.bash && exec ros2 launch /home/roz/ros2_ws/launch/depth_to_scan.launch.py'
Restart=always
RestartSec=5
KillMode=control-group
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
