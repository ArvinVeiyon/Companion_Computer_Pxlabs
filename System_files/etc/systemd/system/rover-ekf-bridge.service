[Unit]
Description=Wheel odom -> EKF2 external vision velocity (MANUAL START ONLY)
After=network.target microxrce-agent.service rover-odometry.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=roz
Group=roz
Environment=HOME=/home/roz
WorkingDirectory=/home/roz/ros2_ws
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash && source /home/roz/ros2_ws/install/setup.bash && exec ros2 run rover_ekf_bridge rover_ekf_bridge'
Restart=always
RestartSec=5
KillMode=control-group
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
